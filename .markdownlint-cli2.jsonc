{
	"config": {
		"default": true,
		// Allow inline HTML (common in docs)
		"MD033": false,
		// Allow duplicate headings in different sections
		"MD024": { "siblings_only": true },
		// Line length - disable (docs can be long)
		"MD013": false,
		// Allow trailing punctuation in headings (Chinese docs use it)
		"MD026": false,
		// First line doesn't have to be a top-level heading
		"MD041": false,
		// Allow same text in multiple headings (e.g., "Installation" in different sections)
		"MD025": false,
		// Allow using literal '#' in headings instead of setext style
		"MD060": false
	},
	"globs": ["**/*.md"],
	"ignores": ["node_modules", "src-tauri/target", "dist", ".agents"]
}
